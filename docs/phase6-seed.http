@base = http://127.0.0.1:8080/api

### Fresh database only. Send each request ONCE, top to bottom.
### MySQL cash check:  mysql -u root -p vira -e "SELECT balance FROM cash_in_hand;"

### S1. Item (MRP 500, 10% -> rate 450)
# @name item
POST {{base}}/items
Content-Type: application/json

{ "name": "P5 Brake Pad", "unit": "Pcs", "bikeIds": [],
  "itemType": "MRP", "mrp": 500.00, "defaultDiscountPercent": 10.00 }

### S2. Party A (opening 1000)
# @name partyA
POST {{base}}/parties
Content-Type: application/json

{ "name": "P5 Party A", "openingBalance": 1000.00 }

### S3. Party B (opening 0)
# @name partyB
POST {{base}}/parties
Content-Type: application/json

{ "name": "P5 Party B", "openingBalance": 0.00 }

### S4. Supplier
# @name supplier
POST {{base}}/suppliers
Content-Type: application/json

{ "name": "P5 Supplier" }

### G1. Voucher 300 CASH on Party A
# @name voucher
POST {{base}}/payment-vouchers
Content-Type: application/json

{ "partyId": {{partyA.response.body.id}}, "paymentDate": "2026-10-21",
  "amount": 300.00, "paymentMode": "CASH" }

### G1 check: Party A = 700.00 ; cash = 300.00
GET {{base}}/parties/{{partyA.response.body.id}}

### G2. Supplier payment 200
# @name supPay
POST {{base}}/supplier-payments
Content-Type: application/json

{ "supplierId": {{supplier.response.body.id}}, "paymentDate": "2026-10-21",
  "amount": 200.00, "paymentMode": "CASH" }

### G2 check: cash = 100.00

### A1. Cash Bill qty 3 -> grandTotal 1350.00, billNo "1"
# @name cashBill
POST {{base}}/bills
Content-Type: application/json

{ "billType": "CASH", "billDate": "2026-10-21",
  "lines": [ { "itemId": {{item.response.body.id}}, "qty": 3, "mrp": 500.00, "discountPercent": 10.00 } ] }

### A1 check: cash = 1450.00

### A3. Party Bill on Party A qty 1 -> grandTotal 450.00, billNo "2", previousBalance 700.00, totalDue 1150.00
# @name partyBill
POST {{base}}/bills
Content-Type: application/json

{ "billType": "PARTY", "partyId": {{partyA.response.body.id}}, "billDate": "2026-10-21",
  "lines": [ { "itemId": {{item.response.body.id}}, "qty": 1, "mrp": 500.00, "discountPercent": 10.00 } ] }

### A3 check: Party A = 1150.00
GET {{base}}/parties/{{partyA.response.body.id}}

### A3c. Party Bill on Party B qty 2 -> grandTotal 900.00, billNo "3", previousBalance 0.00, totalDue 900.00
# @name partyBillB
POST {{base}}/bills
Content-Type: application/json

{ "billType": "PARTY", "partyId": {{partyB.response.body.id}}, "billDate": "2026-10-21",
  "lines": [ { "itemId": {{item.response.body.id}}, "qty": 2, "mrp": 500.00, "discountPercent": 10.00 } ] }

### A3c check: Party B = 900.00 ; Party A = 1150.00 ; cash = 1450.00
GET {{base}}/parties/{{partyB.response.body.id}}


### ===== STEP 1 LEFTOVER (C5) =====

### C5. Must be 400 with code MALFORMED_REQUEST
GET {{base}}/parties?deleted=maybe


### ===== STEP 2 CHECKS =====

### 2-1. GET the Party Bill (bill 2). Expect previousBalance 700.00, totalDue 1150.00,
###      deleted false, actions canEdit true / canDelete true / canRestore false
GET {{base}}/bills/{{partyBill.response.body.id}}

### 2-2. GET the Cash Bill (bill 1). Expect previousBalance null, totalDue null
GET {{base}}/bills/{{cashBill.response.body.id}}

### 2-3. Delete the Party Bill -> 204
DELETE {{base}}/bills/{{partyBill.response.body.id}}

### 2-4. GET it again. Expect deleted true, actions canRestore true / canEdit false / canDelete false
GET {{base}}/bills/{{partyBill.response.body.id}}

### 2-5. Restore it -> 200. Expect previousBalance 700.00, totalDue 1150.00, deleted false
POST {{base}}/bills/{{partyBill.response.body.id}}/restore

### 2-6. Unknown bill -> 404
GET {{base}}/bills/9999