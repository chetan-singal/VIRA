@base = http://127.0.0.1:8080/api

### 0. Setup status (not complete on a fresh database)
GET {{base}}/setup/status

### 1. First-run setup (only on a database with no bills, vouchers or supplier payments)
POST {{base}}/setup
Content-Type: application/json

{
  "shopName": "Chirag Auto Parts",
  "cashBillPrefix": "C-", "partyBillPrefix": "P-",
  "voucherPrefix": "PV-", "supplierPaymentPrefix": "SP-",
  "startingBillNumber": 1001,
  "openingCashInHand": 5000.00, "openingCashInHandDate": "2026-04-01",
  "printShowShopName": true, "printShowAddress": true, "printShowPhone": true,
  "printShowLogo": true, "printShowThankyou": true, "printShowMrp": true
}

### 2. Run request 1 again -> 409 SETUP_ALREADY_DONE
POST {{base}}/setup
Content-Type: application/json

{
  "shopName": "Chirag Auto Parts",
  "cashBillPrefix": "C-", "partyBillPrefix": "P-",
  "voucherPrefix": "PV-", "supplierPaymentPrefix": "SP-",
  "startingBillNumber": 1001,
  "openingCashInHand": 5000.00, "openingCashInHandDate": "2026-04-01",
  "printShowShopName": true, "printShowAddress": true, "printShowPhone": true,
  "printShowLogo": true, "printShowThankyou": true, "printShowMrp": true
}

### 3. Shop profile
GET {{base}}/shop-profile

### 4. An item (MRP 500, 10%) and a party with an opening balance
# @name item
POST {{base}}/items
Content-Type: application/json

{ "name": "Brake Pad", "unit": "Pcs", "itemType": "MRP", "mrp": 500.00, "defaultDiscountPercent": 10.00 }

###
# @name partyA
POST {{base}}/parties
Content-Type: application/json

{ "name": "Ramesh Motors", "openingBalance": 200.00 }

### 5. Cash Bill -> bill_no C-1001
# @name cashBill
POST {{base}}/bills
Content-Type: application/json

{ "billType": "CASH", "billDate": "2026-10-29",
  "lines": [ { "itemId": {{item.response.body.id}}, "qty": 2, "mrp": 500.00, "discountPercent": 10.00 } ] }

### 6. Party Bill -> bill_no P-1002, previousBalance 200.00, totalDue 650.00
# @name partyBill
POST {{base}}/bills
Content-Type: application/json

{ "billType": "PARTY", "partyId": {{partyA.response.body.id}}, "billDate": "2026-10-29",
  "lines": [ { "itemId": {{item.response.body.id}}, "qty": 1, "mrp": 500.00, "discountPercent": 10.00 } ] }

### 7. Read it back -> the same previousBalance and totalDue
GET {{base}}/bills/{{partyBill.response.body.id}}

### 8. Starting Bill Number is locked now -> 409 SETUP_VALUES_LOCKED
PUT {{base}}/shop-profile
Content-Type: application/json

{
  "shopName": "Chirag Auto Parts",
  "cashBillPrefix": "C-", "partyBillPrefix": "P-",
  "voucherPrefix": "PV-", "supplierPaymentPrefix": "SP-",
  "startingBillNumber": 5000,
  "openingCashInHand": 5000.00, "openingCashInHandDate": "2026-04-01",
  "printShowShopName": true, "printShowAddress": true, "printShowPhone": true,
  "printShowLogo": true, "printShowThankyou": true, "printShowMrp": true
}

### 9. Delete the Cash Bill
DELETE {{base}}/bills/{{cashBill.response.body.id}}

### 10. Daybook without deleted -> summary.totalBills 1
GET {{base}}/daybook?from=2026-10-01&to=2026-10-31

### 11. Daybook with deleted -> two rows, the same summary
GET {{base}}/daybook?from=2026-10-01&to=2026-10-31&includeDeleted=true

### 12. Keyword search by item name, and the Party's Bills tab
GET {{base}}/daybook?keyword=brake

###
GET {{base}}/daybook?partyId={{partyA.response.body.id}}

### 13. A voucher, its list (deleted included), and the balance summary
# @name voucher
POST {{base}}/payment-vouchers
Content-Type: application/json

{ "partyId": {{partyA.response.body.id}}, "paymentDate": "2026-10-22", "amount": 650.00, "paymentMode": "ONLINE" }

###
GET {{base}}/payment-vouchers?partyId={{partyA.response.body.id}}&includeDeleted=true

###
GET {{base}}/parties/{{partyA.response.body.id}}/balance-summary

### 14. Party item rates
POST {{base}}/pricing/permanent-changes
Content-Type: application/json

{ "itemId": {{item.response.body.id}}, "customer": "PARTY", "partyId": {{partyA.response.body.id}},
  "field": "DISCOUNT_PERCENT", "newValue": 15.00 }

###
GET {{base}}/parties/{{partyA.response.body.id}}/item-rates

### 15. Dashboard: a month (daily trend) and a quarter (monthly trend)
GET {{base}}/dashboard?period=MONTH

###
GET {{base}}/dashboard?period=CUSTOM&from=2026-10-01&to=2026-12-31

### 16. Part search, Settings, Recalculate
GET {{base}}/part-search?q=brake

###
GET {{base}}/settings

###
PUT {{base}}/settings
Content-Type: application/json

{ "defaultBillType": "CASH", "defaultFocusField": "item_search", "defaultPrinter": "",
  "dateFormat": "DD-MM-YYYY", "theme": "dark" }

###
GET {{base}}/maintenance/recalculate-balances








### F12-1. Party
# @name f1
POST {{base}}/parties
Content-Type: application/json

{ "name": "F12 Old Name", "city": "Ludhiana" }

### F12-2. Item
# @name f2
POST {{base}}/items
Content-Type: application/json

{ "name": "F12 Item", "unit": "Pcs", "bikeIds": [],
  "itemType": "MRP", "mrp": 500.00, "defaultDiscountPercent": 10.00 }

### F12-3. Party Bill
POST {{base}}/bills
Content-Type: application/json

{ "billType": "PARTY", "partyId": {{f1.response.body.id}}, "billDate": "2026-10-25",
  "lines": [ { "itemId": {{f2.response.body.id}}, "qty": 1, "mrp": 500.00, "discountPercent": 10.00 } ] }

### F12-4. Rename the party -> 200, name "F12 New Name", balance unchanged
PUT {{base}}/parties/{{f1.response.body.id}}
Content-Type: application/json

{ "name": "F12 New Name", "city": "Ludhiana" }

### F12-5. Daybook -> the bill still shows the old name "F12 Old Name"
GET {{base}}/daybook?partyId={{f1.response.body.id}}

### F12-6. Supplier
# @name f6
POST {{base}}/suppliers
Content-Type: application/json

{ "name": "F12 Old Supplier", "city": "Ludhiana" }

### F12-7. Rename the supplier -> 200, name "F12 New Supplier"
PUT {{base}}/suppliers/{{f6.response.body.id}}
Content-Type: application/json

{ "name": "F12 New Supplier", "city": "Ludhiana" }

### F12-8. Delete the supplier, then edit it -> 409 SUPPLIER_DELETED
DELETE {{base}}/suppliers/{{f6.response.body.id}}

### F12-9. Edit the deleted supplier
PUT {{base}}/suppliers/{{f6.response.body.id}}
Content-Type: application/json

{ "name": "F12 Blocked", "city": "Ludhiana" }